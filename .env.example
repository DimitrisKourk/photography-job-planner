# Copy this file to .env and fill in your own values

# MySQL connection
db_host=localhost
db_name=photography_job_planner
db_user=your_mysql_user
db_password=your_mysql_password
# db_port=3306
# CA certificate for SSL connections (e.g. Aiven), path relative to the project root
# db_ssl_ca=./ca.pem

# Secret used to sign session cookies (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Server port (optional, defaults to 4000)
# port=4000

# Set to production when serving over HTTPS (makes the session cookie https-only)
# NODE_ENV=production

# Google Calendar sync (optional; leave empty to disable)
# GOOGLE_KEY_FILE=./service-account.json
# GOOGLE_PROJECT_NUMBER=
# GOOGLE_CALENDAR_ID=
